# Supabase API Credentials
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=sb_publishable_<your-publishable-key>

# White-Label Branding Configuration
APP_NAME=Gedoong
APP_DESCRIPTION="CRM Properti untuk Agen Independen Indonesia"
APP_LOGO=/03_LOGO_MAIN.png
APP_LOGO_TRANSPARENT=/02_LOGO_TRANSPARENT.png
APP_BANNER=/01_BANNER.png

# Support & Contact Information
SUPPORT_EMAIL=support@gedoong.id
SUPPORT_PHONE=0812-3456-7890
COPYRIGHT_TEXT="Gedoong. Seluruh hak cipta dilindungi."

# GitHub & Open Source
GITHUB_REPO=https://github.com/<your-org>/<your-repo>

# Cloudflare Turnstile (Anti-Robot)
# Development: 1x00000000000000000000AA (always passes)
# Production: get keys at https://dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
